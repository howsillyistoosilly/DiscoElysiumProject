<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-state layout — no visibility toggling.
    Idle state:   portrait is empty (black card), title = "DISCO CHECK", quote = "Tap to roll."
    Result state: portrait filled, title = skill name, quote = skill quote
    Volition:     portrait = Volition.jpg, title = "VOLITION", quote = patience message
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/disco_widget_background">

    <!-- Skill portrait — empty in idle state, filled after roll -->
    <ImageView
        android:id="@+id/widget_portrait"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Gradient scrim always present — invisible when portrait is empty -->
    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/disco_widget_scrim" />

    <!-- Bottom content strip (always visible) -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top bar: title + two dice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DISCO CHECK"
                android:textColor="#B7A0E5"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_die_one"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:padding="3dp" />

            <ImageView
                android:id="@+id/widget_die_two"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:padding="3dp" />

        </LinearLayout>

        <!-- Quote / prompt text -->
        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:text="Tap to roll."
            android:textColor="#D8D8D8"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
