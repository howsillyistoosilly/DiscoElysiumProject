<?xml version="1.0" encoding="utf-8"?>
<!--
    Disco Elysium Home-screen Widget
    Visual states:
      1. IDLE/STANDBY: "Check your Skill" over the wavy Volition 6-cross card
      2. ROLLING ANIMATION: Rapid skill montage + emerald green flash
      3. RESULT/VOLITION: Portrait + rolled dice + title + quote (or Volition cooldown)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/disco_widget_background">

    <!-- ═══ STANDBY / IDLE STATE (User's Waved Volition + 6-pip dice card) ═══ -->
    <FrameLayout
        android:id="@+id/widget_idle_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Standby textured background from user reference -->
        <ImageView
            android:id="@+id/widget_idle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/disco_widget_standby" />

        <!-- Centered "Check your Skill" text (crisp, readable, slightly bigger) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_idle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:shadowColor="#D0000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Check your Skill"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

    <!-- ═══ RESULT / ANIMATION STATE: Portrait + Roll Details ═══ -->
    <FrameLayout
        android:id="@+id/widget_result_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Skill portrait -->
        <ImageView
            android:id="@+id/widget_portrait"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop" />

        <!-- Gradient scrim overlay -->
        <ImageView
            android:id="@+id/widget_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="fitXY"
            android:src="@drawable/disco_widget_scrim" />

        <!-- Bottom content strip -->
        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Title bar: Skill name / status + rolled dice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:maxLines="1"
                    android:textColor="#B7A0E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_die_one"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:padding="2dp" />

                <ImageView
                    android:id="@+id/widget_die_two"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:padding="2dp" />

            </LinearLayout>

            <!-- Skill quote / Volition cooldown message -->
            <TextView
                android:id="@+id/widget_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="4"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Emerald green flash overlay (ImageView with shape drawable, strictly allowed in RemoteViews) -->
        <ImageView
            android:id="@+id/widget_flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:src="@drawable/disco_widget_flash"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
