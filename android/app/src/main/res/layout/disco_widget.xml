<?xml version="1.0" encoding="utf-8"?>
<!--
    Disco Elysium Home-screen Widget
    Visual states:
      1. STANDBY: ZA/UM Developer styled check screen ("Check your Skill" + telemetry + 6-pip pips)
      2. MONTAGE: Rapid skill portraits (8 frames) + tumbling dice + progressive green glow
      3. RESULT: Resolved skill portrait + rolled dice + title + quote (with top-right RESET button)
      4. VOLITION: Rapid-tap cooldown (10s) reminder with live countdown
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/disco_widget_background">

    <!-- ═══ STANDBY / IDLE STATE (ZA/UM Art-Directed Check Screen) ═══ -->
    <FrameLayout
        android:id="@+id/widget_idle_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Standby textured background (Waved Volition with 6 dice crosses) -->
        <ImageView
            android:id="@+id/widget_idle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/disco_widget_standby" />

        <!-- ZA/UM UI Overlay (Telemetry, Typography, Branding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- ZA/UM Top Telemetry Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:focusable="false"
                    android:letterSpacing="0.12"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="REV. 0.57 // ACTIVE CHECK"
                    android:textColor="#C4A35A"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:letterSpacing="0.1"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="[ 2D6 ]"
                    android:textColor="#8170B2"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ZA/UM Center Core: "Check your Skill" (prominent, bold, tracked) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_idle_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="Check your Skill"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="— THROW THE BONES —"
                    android:textColor="#B7A0E5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ZA/UM Bottom Telemetry Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:focusable="false"
                    android:letterSpacing="0.08"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="INTELLECT • PSYCHE • PHYSIQUE • MOTORICS"
                    android:textColor="#888888"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:letterSpacing="0.08"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="ZA/UM"
                    android:textColor="#777777"
                    android:textSize="8sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ═══ RESULT / ANIMATION STATE: Portrait + Roll Details ═══ -->
    <FrameLayout
        android:id="@+id/widget_result_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Skill portrait -->
        <ImageView
            android:id="@+id/widget_portrait"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop" />

        <!-- Gradient scrim overlay -->
        <ImageView
            android:id="@+id/widget_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="fitXY"
            android:src="@drawable/disco_widget_scrim" />

        <!-- Top-Right Restart / Reset button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:gravity="top|end"
            android:padding="10dp">

            <TextView
                android:id="@+id/widget_btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/disco_widget_btn_restart"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="↺ RESET"
                android:textColor="#C4A35A"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bottom content strip -->
        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Title bar: Skill name / status + rolled dice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:maxLines="1"
                    android:textColor="#B7A0E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_die_one"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:padding="2dp" />

                <ImageView
                    android:id="@+id/widget_die_two"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:padding="2dp" />

            </LinearLayout>

            <!-- Skill quote / Volition cooldown message -->
            <TextView
                android:id="@+id/widget_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="4"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Progressive green glow overlay -->
        <ImageView
            android:id="@+id/widget_flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:src="@drawable/disco_widget_flash_1"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
